<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProControllerConnect</AssemblyName>
    <RootNamespace>ProControllerConnect</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Pro Controller Connect</Product>
    <Version>1.1.0</Version>
    <Description>Automatic Bluetooth reconnection for the Pro Controller</Description>
  </PropertyGroup>

</Project>
