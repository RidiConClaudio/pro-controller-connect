<Window x:Class="ProControllerConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProControllerConnect"
        Title="Pro Controller Connect"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Pro Controller Connect" Margin="10,0,0,0" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="{local:L tip_minimize}"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{local:L tip_close}"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" Margin="2,0,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,0,24,22">

            <!-- Status indicator -->
            <Grid Width="152" Height="152" HorizontalAlignment="Center">
                <Ellipse x:Name="Glow" Width="140" Height="140" Opacity="0.14" Fill="#8B93A3"/>
                <Ellipse x:Name="PulseRing" Width="112" Height="112" StrokeThickness="2"
                         Stroke="#8B93A3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="112" Height="112" Fill="{StaticResource CardBrush}"
                         Stroke="{StaticResource LineBrush}" StrokeThickness="1"/>
                <TextBlock x:Name="StatusGlyph" Text="&#xE7FC;" FontFamily="{StaticResource IconFont}"
                           FontSize="48" Foreground="#8B93A3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="Badge" Width="32" Height="32" CornerRadius="16" BorderThickness="3"
                        BorderBrush="{StaticResource BgBrush}" Background="#8B93A3"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
                    <TextBlock x:Name="BadgeGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusTitle" Text="{local:L starting_title}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock x:Name="StatusDetail" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="10,6,10,0" MinHeight="36"
                       LineHeight="18"/>

            <Button x:Name="MainButton" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="MainButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MainButtonGlyph" Text="&#xE702;" FontFamily="{StaticResource IconFont}"
                               FontSize="16" VerticalAlignment="Center" Margin="0,1,10,0"/>
                    <TextBlock x:Name="MainButtonText" Text="{local:L btn_connect}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Tabs -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="4" CornerRadius="12">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="TabController" Style="{StaticResource Segment}" GroupName="Tabs"
                                 IsChecked="True" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                            <TextBlock Text="{local:L tab_controller}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSettings" Style="{StaticResource Segment}" GroupName="Tabs" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                            <TextBlock Text="{local:L tab_settings}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <Grid Margin="0,12,0,0">
            <!-- Controller tab -->
            <Grid x:Name="ControllerPage">
                <!-- Procedure (when not connected) -->
                <Border x:Name="StepperCard" Style="{StaticResource Card}" Padding="8,16,8,16" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Rectangle Height="2" Fill="{StaticResource LineBrush}" VerticalAlignment="Top"
                                       Margin="48,13,48,0"/>
                            <UniformGrid x:Name="Stepper" Columns="4"/>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="8,16,8,14"/>
                        <StackPanel Margin="12,0">
                            <TextBlock Style="{StaticResource SettingTitle}" FontSize="13" FontWeight="SemiBold" Text="{local:L sync_where_title}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" LineHeight="19" Text="{local:L sync_where_text}"/>
                            <TextBlock Style="{StaticResource SettingTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" Text="{local:L after_title}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" LineHeight="19" Text="{local:L after_text}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live test (when connected) -->
                <Border x:Name="TesterCard" Style="{StaticResource Card}" Padding="14,12,14,12" Visibility="Collapsed" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{local:L live_test}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeviceInfo" Style="{StaticResource SettingDesc}" Text="{local:L device_searching}"/>
                            </StackPanel>
                            <Border x:Name="InputBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="11" Padding="10,4" Background="#2A2F3B">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="InputDot" Width="7" Height="7" Fill="#8B93A3" Margin="0,1,7,0"/>
                                    <TextBlock x:Name="InputBadgeText" Text="{local:L badge_press}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <local:ControllerView x:Name="Pad" Margin="0,10,0,10"/>
                        <Grid>
                            <TextBlock x:Name="AxisText" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}"/>
                            <TextBlock x:Name="LastInputText" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{StaticResource SubTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Settings tab -->
            <StackPanel x:Name="SettingsPage" Visibility="Hidden">
            <Border Style="{StaticResource Card}" Padding="16,2">
                <StackPanel>
                    <CheckBox x:Name="AutoModeSwitch" Style="{StaticResource Switch}" Click="Setting_Click">
                        <StackPanel Margin="0,9">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{local:L set_auto_title}"/>
                            <TextBlock Style="{StaticResource SettingDesc}"
                                       Text="{local:L set_auto_desc}"/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="Setting_Click">
                        <StackPanel Margin="0,9">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{local:L set_startup_title}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{local:L set_startup_desc}"/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                    <CheckBox x:Name="MinimizedSwitch" Style="{StaticResource Switch}" Click="Setting_Click">
                        <StackPanel Margin="0,9">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{local:L set_silent_title}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{local:L set_silent_desc}"/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                    <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Click="Setting_Click">
                        <StackPanel Margin="0,9">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{local:L set_notify_title}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{local:L set_notify_desc}"/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                    <Grid Margin="0,10" ToolTip="{local:L set_lang_desc}">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{local:L set_lang_title}" VerticalAlignment="Center"/>
                        <Border Background="#11141A" CornerRadius="10" Padding="3" HorizontalAlignment="Right" Width="276">
                            <UniformGrid x:Name="LangPanel" Rows="1"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tools -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ToolButton}" Click="RestartBt_Click" ToolTip="{local:L tool_restart_tip}">
                    <StackPanel>
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:L tool_restart}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ToolButton}" Click="BtSettings_Click" ToolTip="{local:L tool_btsettings_tip}">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:L tool_btsettings}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource ToolButton}" Click="Log_Click" ToolTip="{local:L tool_log_tip}">
                    <StackPanel>
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LogButtonText" Text="{local:L tool_log}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="LogPanel" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10" Visibility="Collapsed">
                <TextBox x:Name="LogBox" IsReadOnly="True" Height="150" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource SubTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" CaretBrush="Transparent"/>
            </Border>
            </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
